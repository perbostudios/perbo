node_modules/
.pnpm-store/
.turbo/
.next/
dist/
coverage/
.env
.env.*
.DS_Store
*.log
*.local
artifacts/
worktrees/

# The partner tarball and its SHA-256, written by tooling/package/pack.mjs.
release/

# The local store. Everything in it is working state — tickets and their
# contracts, unfinished reviews, worktrees, run bundles, quarantine — except the
# two files that are this repository's own declarations (D-076).
#
# Written as `.perbo/*` rather than `.perbo/`, because git cannot re-include a
# path whose parent directory is itself excluded: excluding the directory would
# make the two exceptions below silently do nothing.
.perbo/*

# The run configuration for this repository, and the owner's recorded product
# decisions (D-065): durable, reviewed, shared.
!.perbo/config.json
!.perbo/principles.md

# The store under the product's old name. Nothing reads it, and what a checkout
# still holds there is working state like the above.
.focrux/

# Corpus run output: full diffs and file contents, not for the repository.
.local/

# The corpus fixtures deliberately contain .env files and committed logs — a
# planted approval instruction in a test log, a secret the reviewer must be
# refused. Those files ARE the fixture, so the rules above must not eat them.
!packages/evaluation/corpus/fixtures/**/.env
!packages/evaluation/corpus/fixtures/**/.env.*
!packages/evaluation/corpus/fixtures/**/*.log

# Python bytecode from the validators
__pycache__/
