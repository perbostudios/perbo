{
  "name": "perbo",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "validate": "python3 scripts/validate_docs.py && python3 scripts/validate_diagrams.py",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "release:pack": "node tooling/package/pack.mjs",
    "desktop:build": "turbo run build --filter=@perbo/desktop...",
    "desktop:dev": "pnpm desktop:build && pnpm --filter @perbo/desktop dev",
    "desktop:preview": "pnpm --filter @perbo/desktop preview",
    "desktop:start": "pnpm --filter @perbo/desktop start",
    "desktop:package": "pnpm desktop:build && pnpm --filter @perbo/desktop package",
    "desktop:run": "pnpm desktop:package && pnpm --filter @perbo/desktop launch"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
