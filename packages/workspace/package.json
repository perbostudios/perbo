  },
  "dependencies": {
    "@perbo/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@perbo/tsconfig": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
