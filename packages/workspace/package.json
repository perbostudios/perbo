{
  "name": "@perbo/workspace",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "perbo-materialisation": "./dist/main.js"
  },
  "exports": {
