{
  "name": "@perbo/evaluation",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "perbo-corpus": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "corpus",
    "sample",
    "SCORING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "corpus": "node dist/main.js"
  },
  "dependencies": {
    "@perbo/cli": "workspace:*",
    "@perbo/contracts": "workspace:*",
    "@perbo/review": "workspace:*",
    "@perbo/runner": "workspace:*",
    "@perbo/workspace": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@perbo/test-support": "workspace:*",
    "@perbo/tsconfig": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
