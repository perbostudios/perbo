        "requestAttestation": false
      }
    }
  },
  {
    "method": "initialized",
    "params": {}
  },
  {
    "method": "thread/start",
    "id": 2,
    "params": {
      "model": "gpt-5.6-terra",
      "allowProviderModelFallback": false,
      "cwd": "<scratch>",
      "runtimeWorkspaceRoots": [
        "<scratch>"
      ],
      "approvalPolicy": "never",
      "sandbox": "read-only",
      "baseInstructions": "system prompt",
      "developerInstructions": "You are a stateless semantic reviewer. Do not call tools: none are available. Return only JSON matching the supplied schema. Choose read_files to ask the orchestrator for repository files, or submit_review to return the verdict.",
      "environments": [],
      "dynamicTools": [],
      "selectedCapabilityRoots": [],
      "ephemeral": true
    }
  },
  {
    "method": "turn/start",
    "id": 3,
    "params": {
      "threadId": "thr_1",
      "input": [
        {
          "type": "text",
