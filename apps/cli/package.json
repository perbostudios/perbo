{
  "name": "@perbo/cli",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.bundle.js",
  "bin": {
    "perbo": "./dist/perbo.js"
  },
  "exports": {
    ".": {
      "default": "./dist/index.bundle.js"
    }
  },
  "files": [
    "dist/perbo.js",
    "dist/guard-hook.js",
    "dist/index.bundle.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tooling/package/bundle.mjs --package",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@perbo/contracts": "workspace:*",
    "@perbo/planning": "workspace:*",
    "@perbo/review": "workspace:*",
    "@perbo/runner": "workspace:*",
    "@perbo/tsconfig": "workspace:*",
    "@perbo/workspace": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
